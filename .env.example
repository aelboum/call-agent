# Environment template. Copy to `.env` and fill in locally.
#
# `.env` is gitignored and MUST NEVER be committed. This file contains no
# real value: every entry below is either a placeholder or a safe default.
# A real secret is read through SaaS-OS's `infra.secrets` provider, never
# from product configuration code.
#
# Two naming conventions, deliberately: variables owned by the pinned
# SaaS-OS platform keep their own names, and product variables are prefixed
# `VOICEAGENT_`. The product never re-parses a platform variable.

# ---------------------------------------------------------------------------
# Platform (SaaS-OS) -- owned by core.config / infra.*
# ---------------------------------------------------------------------------

ENVIRONMENT=development          # development | test | production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/v1
HOST=0.0.0.0
PORT=8000

# The role the APPLICATION runs as. It must not be a superuser and must not
# have BYPASSRLS: the platform's startup guard refuses to become ready under
# an unsafe role, because Row-Level Security is the tenant-isolation boundary.
DATABASE_URL=postgresql+psycopg://saas_os_app:CHANGE_ME@localhost:5432/voiceagent

# The role MIGRATIONS run as -- the schema owner, which by design is a
# different, more privileged role than the one above. Both point at the one
# physical database this product owns.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://saas_os_owner:CHANGE_ME@localhost:5432/voiceagent

# The application role's name, used by product migrations to issue grants
# inside the `app` schema. Must be a plain SQL identifier.
APP_DB_USER=saas_os_app

# Required at import time, not only at runtime: platform modules register
# background jobs at module scope.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Product (voiceagent)
# ---------------------------------------------------------------------------

# Commercial branding is configuration, never a literal in the code
# (ADR-0005). The commercial product name is deliberately undecided.
VOICEAGENT_APP_DISPLAY_NAME=AI Call Agent

# Comma-separated. Empty means no CORS middleware at all -- never a wildcard.
# In production every entry must be an https:// URL, and "*" is refused at
# startup.
VOICEAGENT_CORS_ALLOWED_ORIGINS=

VOICEAGENT_TELEMETRY_SERVICE_NAME=voiceagent

# --- Object storage for call artifacts (Phase 2+; no client exists yet) -----
# Credentials are NOT configured here: the storage adapter resolves them from
# the deployment's own secret source when it is built.
VOICEAGENT_OBJECT_STORAGE_PROVIDER=
VOICEAGENT_OBJECT_STORAGE_BUCKET=
VOICEAGENT_OBJECT_STORAGE_ENDPOINT_URL=
VOICEAGENT_OBJECT_STORAGE_REGION=
VOICEAGENT_OBJECT_STORAGE_PREFIX=recordings

# --- FreeSWITCH (Phase 2+; nothing connects yet) ---------------------------
# There is deliberately no ESL password entry: that is a secret, read through
# `infra.secrets` by the adapter.
VOICEAGENT_FREESWITCH_ESL_HOST=
VOICEAGENT_FREESWITCH_ESL_PORT=8021
VOICEAGENT_FREESWITCH_MEDIA_PUBLIC_URL=

# --- AI providers (Phase 2+) -----------------------------------------------
# Selection only. There is no API-key entry anywhere in this file by design:
# a tenant's provider credentials are product-owned rows encrypted with
# `core.crypto` using tenant_id as associated data, not a deployment-global
# value. "fake" is the only engine the Phase 1 foundation understands.
VOICEAGENT_DEFAULT_ENGINE=fake
