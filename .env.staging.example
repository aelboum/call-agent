# Staging environment template (Phase 2.19). Copy this file:
#
#   cp .env.staging.example .env.staging
#
# ...fill in every value below with the real staging deployment's own
# configuration, and NEVER commit `.env.staging` (it is already covered by
# `.gitignore`'s `*.env` / local-secrets convention -- verify before your
# first commit if this repository's `.gitignore` predates this file).
#
# Every value shown here is a placeholder. None of them work against any
# real system. `docker-compose.staging.yml` reads this file via
# `--env-file .env.staging` and fails closed (`variable is not set` at
# `docker compose config`/`up` time) on every required value left as-is or
# unset -- that is deliberate, not a bug: an operator must supply a real
# value for every `:?...` reference in that file before staging can start.
#
# See docs/PHASE-2.19-STAGING-INTEGRATION.md for what each variable does,
# whether it is a secret, and which deployment stage requires it.

# --- PostgreSQL (authoritative runtime/business state) ---------------------
# Real, TLS-terminated staging PostgreSQL. `sslmode=require` is enforced
# automatically once DB_REQUIRE_TLS=true (set in docker-compose.staging.yml).
DATABASE_URL=postgresql+psycopg://voiceagent_app:CHANGE_ME@staging-db.internal:5432/voiceagent  # pragma: allowlist secret -- placeholder, not a real credential
MIGRATIONS_DATABASE_URL=postgresql+psycopg://voiceagent_migrate:CHANGE_ME@staging-db.internal:5432/voiceagent  # pragma: allowlist secret -- placeholder, not a real credential
APP_DB_USER=voiceagent_app

# --- Redis (non-authoritative: heartbeats, job queue -- never business state) ---
# `rediss://` (TLS) is required once REDIS_REQUIRE_TLS=true.
REDIS_URL=rediss://staging-redis.internal:6379/0

# --- OIDC (real identity provider; SaaS-OS's own auth routes, see
# api/auth/config.py and core/identity/provider.py -- provider-agnostic
# despite the ZITADEL_* names, ADR-0005) ------------------------------------
OIDC_REDIRECT_URI=https://staging.example.com/auth/callback
ZITADEL_ISSUER_URL=https://your-idp.example.com
ZITADEL_CLIENT_ID=CHANGE_ME_CLIENT_ID
# Leave empty for a public client using PKCE (no client secret); set only if
# the identity provider issued a confidential-client secret.
ZITADEL_CLIENT_SECRET=
AUTH_POST_LOGIN_PATH=/
# true only if this deployment terminates TLS at a trusted reverse proxy
# that sets X-Forwarded-For itself (`core.config`'s own `_resolve_client_address`).
TRUST_PROXY_HEADERS=false

# --- Frontend/CORS (must be https:// in staging; Settings rejects otherwise) ---
VOICEAGENT_CORS_ALLOWED_ORIGINS=https://staging.example.com
FRONTEND_API_UPSTREAM=http://api:8000

# --- AI provider selection (deployment-wide eligibility policy --
# voiceagent.runtime.privacy; NOT a per-agent credential -- see ADR-0009 and
# Phase 0 report section 2.4 G-3: a tenant's own provider credentials are a
# separate, encrypted, per-tenant concern, not this variable) --------------
# Comma-separated real provider names this deployment is authorized to use.
# validate_deployment_readiness() rejects the unconfigured default ("fake")
# once VOICEAGENT_DEPLOYMENT_STAGE=staging/production.
VOICEAGENT_AI_ELIGIBLE_PROVIDERS=groq
VOICEAGENT_AI_ALLOWED_DATA_CLASSIFICATIONS=tenant_data
VOICEAGENT_AI_ALLOWED_PURPOSES=conversation

# --- Vendor API keys (real secrets -- each adapter reads its own name
# through infra.secrets; leave any vendor you are not using empty) ---------
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Call intelligence (post-call analysis; its own provider/model select,
# voiceagent/config/settings.py:CallIntelligenceSettings) ------------------
VOICEAGENT_CALL_INTELLIGENCE_PROVIDER=groq
VOICEAGENT_CALL_INTELLIGENCE_MODEL=llama-3.3-70b-versatile
# Leave empty to use the vendor's own documented default endpoint.
VOICEAGENT_CALL_INTELLIGENCE_ENDPOINT=
VOICEAGENT_CALL_INTELLIGENCE_TIMEOUT_SECONDS=30

# --- Telephony / FreeSWITCH (OPTIONAL -- see
# docs/PHASE-2.19-STAGING-INTEGRATION.md "Known limitations": there is
# still no real TCP ESL transport or wss:// media listener in this
# repository, so leaving these unset is the honest default, not a shortcut) ---
VOICEAGENT_FREESWITCH_ESL_HOST=
VOICEAGENT_FREESWITCH_ESL_PORT=8021
VOICEAGENT_FREESWITCH_COMMAND_TIMEOUT_SECONDS=10
VOICEAGENT_FREESWITCH_MEDIA_PUBLIC_URL=

# --- Runtime / worker identity (provisioned once via
# scripts/bootstrap_rbac.py against the real staging tenant -- see the
# deployment sequence in docs/PHASE-2.19-STAGING-INTEGRATION.md) -----------
VOICEAGENT_RUNTIME_ADDRESS=call-runtime:0
VOICEAGENT_RUNTIME_SYSTEM_ACTOR_USER_ID=
VOICEAGENT_RUNTIME_SYSTEM_SERVICE_ACCOUNT_NAME=voiceagent-runtime
VOICEAGENT_FOLLOWUP_WORKER_TENANT_IDS=
VOICEAGENT_FOLLOWUP_WORKER_SYSTEM_ACTOR_USER_ID=
VOICEAGENT_CALL_INTELLIGENCE_WORKER_TENANT_IDS=
VOICEAGENT_CALL_INTELLIGENCE_SYSTEM_ACTOR_USER_ID=
