# Frontend environment template. Copy to `.env.local` (gitignored).
#
# Only `VITE_`-prefixed variables reach the browser bundle. Never put a
# secret here: everything in this file is public once the app is served.

# Where the API lives. Empty means same-origin, which is what the dev proxy
# and a production deployment behind one domain both use.
VITE_API_BASE_URL=

# Optional fallback display name, used only until `/v1/meta` responds. The
# authoritative value is the API's, which comes from the deployment's own
# configuration (ADR-0005).
VITE_APP_DISPLAY_NAME=
